# Provider base URL without username and password.
UPSTREAM_URL=http://provider.example:8080
# Host directory for the cache, mounted at /data. It needs no backup.
CACHE_PATH=./data
# Optional HTTP proxy for provider traffic, e.g. a Gluetun HTTP proxy.
# UPSTREAM_PROXY=http://gluetun:8888
# VOD_CACHE_GB=10
# MIN_FREE_GB=2
# BUFFER_MINUTES=30
# VOD_KEEP_MINUTES=30
# LIVE_BUFFER_GB=3
# LIVE_IDLE_MINUTES=10
# LIVE_START_DELAY_SECONDS=0
